flow: <F>:3
    {"goal":"Know the prune work well enough to build it","steps":[{"id":1,"step":"crucible-grill/grill","does":"Interview the human, a few questions at a time, until the open goal becomes recorded decisions","skills":["crucible-grill"],"ends_with":{"event":"grill.ended"}},{"id":2,"step":"probe/wanted-grill","does":"Grill the topic that matters","skills":["crucible-grill"],"ends_with":{"event":"grill.ended","match":{"topic":"wanted"}}},{"id":3,"step":"crucible-grill/grill","does":"Interview the human, a few questions at a time, until the open goal becomes recorded decisions","skills":["crucible-grill"],"ends_with":{"event":"grill.ended"}}],"answer":2}

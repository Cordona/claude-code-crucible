--- every hook runs through its component's link
    sh '<skills>/crucible-gate/hooks/post-tool-use/record-gate-answer.sh'
    sh '<skills>/crucible-gate/hooks/pre-tool-use/hold-question-until-card-shown.sh'
    sh '<skills>/crucible-events/hooks/pre-tool-use/deny-direct-event-write.sh'
    sh '<skills>/crucible-dynamic-flow/hooks/stop/remind-flow-position.sh'
    sh '<skills>/crucible-gate/hooks/stop/require-card-shown.sh'
--- crucible-events is linked like every component; without its link, writes refuse plainly
    crucible-events -> <R>/framework/core/main-thread/crucible-events
$ sh <skills>/crucible-effort/scripts/effort-start.sh --name unlinked
    event-write.sh: the components folder beside crucible-events is not there
    [exit 1]
--- the install check names a missing component link
$ sh <R>/framework/core/install/install-check.sh --settings <S>/settings.json
    missing: skill link <skills>/crucible-events -> <R>/framework/core/main-thread/crucible-events
    [exit 1]
--- a stand-in domain component beside core: the scan sees its step
$ sh <skills>/crucible-dynamic-flow/scripts/flow-candidates.sh --stages
    prepare 3
    setup 1
    [exit 0]
$ sh <skills>/crucible-dynamic-flow/scripts/flow-candidates.sh --stage setup
    zz-domain-steps/take-a-break · Pause the effort while a repository is set up · ends with effort.paused · stages: setup · skills: crucible-effort · propose when: when set-up has to wait
    [exit 0]
$ sh <R>/framework/core/main-thread/crucible-dynamic-flow/scripts/flow-candidates.sh --stages
    prepare 3
    [exit 0]
=== effort, through its link
    started: <S>/space/efforts/<id>-installed
$ sh <skills>/crucible-effort/scripts/effort-state.sh --effort <S>/space/efforts/<id>-installed
    open
    [exit 0]
=== flow and gate
$ sh <skills>/crucible-dynamic-flow/scripts/flow-card.sh --file <S>/flow.json
    Flow to agree: Know the work
      1. Interview the human, a few questions at a time, until the open goal becomes recorded decisions [crucible-grill]
         ends with: grill.ended
      2. Pause the effort while a repository is set up [crucible-effort]
         ends with: effort.paused
    [exit 0]
$ sh <skills>/crucible-gate/scripts/gate-answer.sh --effort <S>/space/efforts/<id>-installed --record flow-agree --subject <hex>
    ACCEPTED: 2
    [exit 0]
    agreed: <S>/space/efforts/<id>-installed:3
$ sh <skills>/crucible-dynamic-flow/scripts/open-work.sh --effort <S>/space/efforts/<id>-installed
    flow 3 "Know the work"
    [exit 0]
=== grill
    draft: <S>/space/efforts/<id>-installed/grills/1.json
$ sh <skills>/crucible-grill/scripts/grill-add.sh --grill <S>/space/efforts/<id>-installed/grills/1.json --question Which limits? --recommendation All --reason One call
    q1
    [exit 0]
$ sh <skills>/crucible-grill/scripts/grill-answer.sh --grill <S>/space/efforts/<id>-installed/grills/1.json --id q1 --text All of them
    q1 settled
    [exit 0]
    ended: <S>/space/efforts/<id>-installed/events/000004-grill.ended.json
$ sh <skills>/crucible-dynamic-flow/scripts/flow-step-done.sh --flow <S>/space/efforts/<id>-installed:3 --step 1
    <S>/space/efforts/<id>-installed/events/000005-flow.step.done.json

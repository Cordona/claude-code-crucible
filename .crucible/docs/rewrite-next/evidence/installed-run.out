    v1 holds: diff-0a355b6.patch
    v1 holds: issue-github.com-cli-cli-issues-1.md
$ sh <skills>/crucible-context/scripts/main/context-verify.sh --effort <S>/space/efforts/<id>-installed --file <S>/space/efforts/<id>-installed/events/000010-context.cut.json
    CONTEXT_FILE: <S>/space/efforts/<id>-installed/events/000010-context.cut.json
    CONTEXT_SHA256: <hex>

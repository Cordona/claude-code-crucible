    v1 holds: diff-84c2f11.patch
    v1 holds: ticket-github.com-cli-cli-issues-1.md
$ sh <skills>/crucible-context/scripts/context-verify.sh --effort <S>/space/efforts/<id>-installed --file <S>/space/efforts/<id>-installed/events/000010-context.cut.json
    CONTEXT_FILE: <S>/space/efforts/<id>-installed/events/000010-context.cut.json
    CONTEXT_SHA256: <hex>
    [exit 0]

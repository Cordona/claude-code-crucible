{
  "agent": "code-reviewer",
  "part": "review",
  "input_refs": {
    "context": {
      "event": "context.cut",
      "required": true
    },
    "spec": {
      "event": "spec.approved"
    },
    "grills": {
      "event": "grill.ended",
      "list": true
    },
    "plan": {
      "event": [
        "test-plan.submitted",
        "test-plan.updated"
      ],
      "required": true,
      "named": true
    }
  },
  "tree": [
    "use"
  ],
  "write_scope": "report"
}

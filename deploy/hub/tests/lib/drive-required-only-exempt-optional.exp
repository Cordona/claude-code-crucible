#!/usr/bin/env expect
#
# drive-required-only-exempt-optional.exp — answer only a domain's OPTIONAL kind for
#                                           real, walk back to the domains checklist,
#                                           and press `r` there.
#
# WHY THIS IS A SECOND DRIVER AND NOT A VARIANT OF ITS MANDATORY-KIND SIBLING:
# hi_domain_already_answered's contract is "ANY kind is enough, mandatory or optional",
# and it states its reason — a domain with a real VCS pick and no technology yet HAS
# been answered, and reducing half of it while honoring the other half is a plan nobody
# asked for. lib/drive-required-only-exempt.exp answers the MANDATORY kind, which
# leaves the optional half of that `for` loop entirely unobserved: a predicate that
# skipped optional kinds ("only a technology counts as answered") passes every
# assertion that driver makes. This walk answers the OPTIONAL kind and DECLINES the
# mandatory one, which is the only shape that tells the two predicates apart.
#
# THE KEY SEQUENCE, and why every step of it is load-bearing:
#   1. select BOTH domains                     walk_back_to_domains needs both
#   2. PICK A VCS HOST (optional)              the answer `r` must not destroy
#   3. decline technologies (mandatory)        so the ONLY thing answered is optional
#   4. decline trackers (mandatory)            leaves domain 2 reducible
#   5. walk_back_to_domains                    confirm -> trackers -> technologies ->
#                                              VCS -> domains, one `b` per screen
#   6. `r`                                     the key under test
#   7. the exemption notice                    domain 1 was left alone, and says so
#   8. re-walk VCS and technologies            domain 1's own screens still follow
#   9. confirm                                 apply, and print the payload
# Step 2 is the whole point: the domain's only real answer is of a kind the exemption
# is documented to honor but that no other case exercises.
#
# WHAT DISTINGUISHES THIS FROM THE OPTIONAL-KIND-SKIPPED PREDICATE, stated because the
# obvious candidate does NOT: HUB_BASELINE_ONLY names this domain EITHER WAY, and
# correctly so — its mandatory technology selection really was left empty and accepted,
# and a non-empty OPTIONAL selection never retracts that record (hub-install.sh's own
# HUB_BASELINE_ONLY header excludes the optional kind from the field entirely). What
# differs is the NOTICE and the SCREENS: exempt, the notice fires and steps 8's two
# screens render; reduced, neither happens and the walk goes straight to confirm. The
# ORDER of the recorded domains differs too, because a reduced domain 1 records itself
# during `r` (ahead of domain 2) while an exempt one records later, at its own screen.
#
# The spawn, the screen helper, the back-walk and the payload readback are shared — see
# lib/drive-baseline-only-common.exp for those, and for the marker contract.
#
# Usage: expect -f drive-required-only-exempt-optional.exp SRC TARGET INSTALL HOME PATH
#        with REQUIRED_ONLY_KEY, EXEMPT_NOTICE, EXEMPT_MARKER, CHOSE_MARKER,
#        APPLIED_MARKER, BASELINE_MARKER and SCREEN_MARKER exported.

source [file join [file dirname [info script]] drive-baseline-only-common.exp]

set exempt_marker $env(EXEMPT_MARKER)
set chose_marker  $env(CHOSE_MARKER)

expect_screen "Which domain(s)" "domains-screen"
# By KEY, never by row number — see drive-empty-technology.exp's own note.
send "software-development,project-management\r"
expect_screen "2 selected" "both-domains-toggled"
send "\r"

# THE REAL PICK, on the OPTIONAL screen. `github` is a row key rather than a bare
# number for the same reason the domains are named by key.
expect_screen "select VCS" "vcs-screen"
send "github\r"
expect_screen "1 selected" "vcs-chosen"
puts $chose_marker
send "\r"

# DECLINED, so nothing of the mandatory kind is ever answered. This is what makes the
# optional pick the sole reason the domain counts as answered.
expect_screen "select technologies" "technology-screen"
send "\r"

expect_screen "select tracker" "tracker-screen"
send "\r"

walk_back_to_domains

send "$env(REQUIRED_ONLY_KEY)\r"

# The notice text comes from the caller, the same discipline the markers follow.
expect_screen $env(EXEMPT_NOTICE) "exemption-notice"
puts $exempt_marker

# The exempt domain's own screens, which a reduced domain would not have. The VCS
# screen arrives pre-seeded with the step-2 pick, so a bare Enter keeps it.
expect_screen "select VCS" "vcs-screen-final"
send "\r"
expect_screen "select technologies" "technology-screen-final"
send "\r"

# Enter accepts the SAFE-tier confirm gate (lib/hub-nav.sh's hub_confirm_gate), so the
# walk actually applies and emits the machine payload this case reads.
expect_screen "Proceed?" "confirm-screen-final"
send "\r"

report_baseline_only_payload
